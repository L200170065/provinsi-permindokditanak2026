function getProvinces() {
  const seen = {};
  return DATA_WILAYAH.filter(row => {
    if (seen[row.provinceId]) return false;
    seen[row.provinceId] = true;
    return true;
  }).map(row => ({id: row.provinceId, name: row.province}));
}

function getRegencies(provinceId) {
  const id = String(provinceId || '').trim();
  if (!/^\d{2}$/.test(id)) throw new Error('ID provinsi tidak valid.');
  return DATA_WILAYAH.filter(row => row.provinceId === id)
    .map(row => ({id: row.code, name: row.regency, code: row.code}));
}

function doGet(e) {
  const t = HtmlService.createTemplateFromFile('Index');
  t.view = 'user';

  return t.evaluate()
    .setTitle('Permintaan Data Daerah | Rehabilitasi Sosial Anak')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

function getInitialData() {
  // Bangun data dropdown langsung dari data statis agar tidak bergantung
  // pada pemanggilan getRegencies() saat formulir pertama kali dimuat.
  const regenciesByProvince = {};
  DATA_WILAYAH.forEach(row => {
    const provinceName = String(row.province || '').trim();
    const regencyName = String(row.regency || '').trim();
    if (!provinceName || !regencyName) return;
    if (!regenciesByProvince[provinceName]) regenciesByProvince[provinceName] = [];
    if (!regenciesByProvince[provinceName].includes(regencyName)) {
      regenciesByProvince[provinceName].push(regencyName);
    }
  });
  const provinces = Object.keys(regenciesByProvince).sort((a, b) => a.localeCompare(b, 'id'));
  return { provinces, regenciesByProvince, questions: QUESTIONS };
}

function testInitialData() {
  const data = getInitialData();
  return {
    success: data.provinces.length > 0,
    jumlahProvinsi: data.provinces.length,
    jumlahKabupatenKota: Object.values(data.regenciesByProvince).reduce((n, arr) => n + arr.length, 0),
    contohProvinsi: data.provinces.slice(0, 5)
  };
}

/** Mengambil daftar provinsi yang sudah mengirim data.
 * Jika provinsi mengirim lebih dari sekali, hanya respons dengan Timestamp terbaru yang ditampilkan.
 */
function getSubmittedProvinceStatus() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const sh = ss.getSheetByName(RESPONSE_SHEET);
  const provinceNames = getInitialData().provinces;
  const latestByProvince = new Map();
  if (sh && sh.getLastRow() >= 2) {
    const values = sh.getDataRange().getValues();
    values.slice(1).forEach((r) => {
      const timestampValue = r[0];
      const role = String(r[1] || '').trim();
      const province = String(r[5] || '').trim();
      const status = String(r[11] || '').trim().toLowerCase();
      if (role !== 'Provinsi' || !province || (status && status !== 'terkirim')) return;
      const timestamp = timestampValue instanceof Date ? timestampValue : new Date(timestampValue);
      const millis = timestamp instanceof Date && !isNaN(timestamp.getTime()) ? timestamp.getTime() : 0;
      const existing = latestByProvince.get(province);
      if (!existing || millis >= existing.millis) {
        latestByProvince.set(province, {
          millis: millis,
          timestamp: millis ? Utilities.formatDate(new Date(millis), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm') : String(timestampValue || '')
        });
      }
    });
  }
  const rows = provinceNames.map(province => {
    const found = latestByProvince.get(province);
    return {
      province: province,
      submitted: !!found,
      timestamp: found ? found.timestamp : ''
    };
  });
  const totalSubmitted = rows.filter(row => row.submitted).length;
  return { success: true, total: rows.length, submitted: totalSubmitted, pending: rows.length - totalSubmitted, rows: rows };
}

function submitResponse(payload) {
  ensureSheets_();
  validatePayload_(payload);
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const sh = ss.getSheetByName(RESPONSE_SHEET);
  const details = payload.details || [];
  const totalL = details.reduce((s, x) => s + Number(x.laki || 0), 0);
  const totalP = details.reduce((s, x) => s + Number(x.perempuan || 0), 0);
  const row = [
    new Date(),
    'Provinsi',
    payload.nama.trim(),
    payload.nip.trim(),
    String(payload.whatsapp || '').trim(),
    payload.provinsi || '',
    payload.kabupatenKota || '',
    totalL,
    totalP,
    totalL + totalP,
    JSON.stringify(details),
    'Terkirim'
  ];
  sh.appendRow(row);
  return { success: true, message: 'Data berhasil dikirim.', id: sh.getLastRow() - 1 };
}

function adminLogin(pin) {
  const savedPin = PropertiesService.getScriptProperties().getProperty('ADMIN_PIN');
  if (!savedPin) return { success: false, message: 'ADMIN_PIN belum disetel. Ikuti petunjuk pada README.' };
  if (String(pin || '') !== savedPin) return { success: false, message: 'PIN admin tidak sesuai.' };
  const token = Utilities.getUuid();
  CacheService.getScriptCache().put('admin_' + token, '1', 60 * 60);
  return { success: true, token: token };
}

function getAdminData(token) {
  if (!token || CacheService.getScriptCache().get('admin_' + token) !== '1') {
    throw new Error('Sesi admin tidak valid atau sudah berakhir. Silakan login kembali.');
  }
  ensureSheets_();
  const sh = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(RESPONSE_SHEET);
  const values = sh.getDataRange().getValues();
  if (values.length < 2) return { headers: values[0] || [], rows: [], stats: { total: 0, provinsi: 0, kabkota: 0, pppk: 0 } };
  const rows = values.slice(1).reverse().map((r, i) => ({
    timestamp: r[0] instanceof Date ? Utilities.formatDate(r[0], Session.getScriptTimeZone(), 'dd MMM yyyy HH:mm') : String(r[0]),
    role: String(r[1] || ''),
    nama: String(r[2] || ''),
    nip: String(r[3] || ''),
    whatsapp: String(r[4] || ''),
    provinsi: String(r[5] || ''),
    kabupatenKota: String(r[6] || ''),
    totalLaki: Number(r[7] || 0),
    totalPerempuan: Number(r[8] || 0),
    total: Number(r[9] || 0),
    details: String(r[10] || '[]'),
    status: String(r[11] || '')
  }));
  return {
    headers: values[0],
    rows,
    stats: {
      total: rows.length,
      provinsi: rows.filter(r => r.role === 'Provinsi').length,
      kabkota: 0,
      pppk: 0
    }
  };
}

function ensureSheets_() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  let response = ss.getSheetByName(RESPONSE_SHEET);
  if (!response) response = ss.insertSheet(RESPONSE_SHEET);
  const headers = ['Timestamp','Jenis Inputer','Nama','NIP','Nomor WhatsApp','Provinsi','Kabupaten/Kota','Total Laki-laki','Total Perempuan','Total Anak','Detail Data (JSON)','Status'];
  if (response.getLastRow() === 0) {
    response.appendRow(headers);
    response.setFrozenRows(1);
  } else {
    const existing = response.getRange(1, 1, 1, Math.max(response.getLastColumn(), 1)).getDisplayValues()[0];
    if (!existing.includes('Nomor WhatsApp')) {
      response.insertColumnAfter(4);
      response.getRange(1, 5).setValue('Nomor WhatsApp');
      if (response.getLastColumn() < headers.length) {
        response.getRange(1, 6, 1, headers.length - 5).setValues([headers.slice(5)]);
      }
    }
  }
  let wilayah = ss.getSheetByName(WILAYAH_SHEET);
  if (!wilayah) {
    wilayah = ss.insertSheet(WILAYAH_SHEET);
    wilayah.appendRow(['Provinsi','Kabupaten/Kota']);
    wilayah.setFrozenRows(1);
  }
}

function validatePayload_(p) {
  if (!p) throw new Error('Data tidak valid.');
  if (!String(p.nama || '').trim()) throw new Error('Nama wajib diisi.');
  if (!String(p.nip || '').trim()) throw new Error('NIP wajib diisi.');
  const wa = String(p.whatsapp || '').replace(/[\s-]/g, '');
  if (!wa) throw new Error('Nomor WhatsApp wajib diisi.');
  if (!/^\+?\d{9,15}$/.test(wa)) throw new Error('Nomor WhatsApp tidak valid. Masukkan 9–15 digit, boleh diawali +62.');
  if (!p.provinsi) throw new Error('Provinsi wajib dipilih.');
  
  if (!Array.isArray(p.details) || p.details.length !== QUESTIONS.length) throw new Error('Detail data tidak lengkap.');
  p.details.forEach((d, i) => {
    const l = Number(d.laki), pr = Number(d.perempuan);
    if (!Number.isInteger(l) || l < 0 || !Number.isInteger(pr) || pr < 0) throw new Error('Jumlah laki-laki dan perempuan harus berupa bilangan bulat nol atau lebih.');
    if (i === 0) ['korban', 'pelaku', 'saksi'].forEach(key => {
      const n = Number(d[key] == null ? 0 : d[key]);
      if (!Number.isInteger(n) || n < 0) throw new Error('Jumlah Korban, Pelaku, dan Saksi pada ABH harus berupa bilangan bulat nol atau lebih.');
    });
  });
}
